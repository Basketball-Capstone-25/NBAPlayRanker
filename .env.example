# Copy this file to .env and fill in the values.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)

# ── Backend (Python / FastAPI) ──────────────────────────────────
# Legacy HS256 only. ES256/RS256 verification uses SUPABASE_URL + public JWKS
# and does not require the project's private signing key or this legacy secret.
SUPABASE_JWT_SECRET=

# Supabase project URL – used to fetch JWKS public keys for ES256 tokens.
SUPABASE_URL=

# Optional local-only bypass. Leave false for normal auth and all deployments.
ALLOW_INSECURE_DEV_AUTH=false

# ── Frontend (Next.js) ──────────────────────────────────────────
# Base URL of the running backend API.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Supabase project credentials (Settings > API > Project API keys).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
